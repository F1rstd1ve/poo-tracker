// Gassi-Server (ADR 0006).
// Etappe A: static Mülleimer-Kacheln in public/t1, generated by
// pipeline/build_tiles.py (not in git), served for free as static assets.
// Etappe B: shared Mülleimer API in src/index.js with the D1 database
// "poo-tracker" (migrations/). The script only runs for /api/*.
{
  "name": "poo-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poo-tracker",
      "database_id": "1d340a94-349c-4bf4-94e6-81a2d2490bb6",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Daily cleanup (unconfirmed bins, reports, counters).
    "crons": ["41 2 * * *"]
  }
}
